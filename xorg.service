[Unit]
Description=Minimal X session
After=systemd-user-sessions.service

[Service]
User=raspi
PAMName=login
Environment=DISPLAY=:0
TTYPath=/dev/tty1
StandardInput=tty
ExecStart=/usr/bin/startx /home/raspi/fogscreen-server/start-display.sh -- :0 vt1
Restart=on-failure

[Install]
WantedBy=multi-user.target
